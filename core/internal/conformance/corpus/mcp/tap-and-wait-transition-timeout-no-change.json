{
  "name": "tap-and-wait-transition-timeout-no-change",
  "description": "tap_and_wait_transition times out with classification no_change_detected when only waitForAbsent is given and its anchor never disappears from the one staged, unchanging screen.",
  "driver": {
    "hierarchy": {
      "attributes": { "role": "container", "bounds": "0,0,430,932" },
      "children": [
        {
          "attributes": { "role": "label", "id": "header_label", "text": "Home", "bounds": "20,20,200,60" },
          "children": []
        },
        {
          "attributes": { "role": "button", "id": "noop_btn", "text": "Do Nothing", "bounds": "100,400,330,460" },
          "children": [],
          "enabled": true,
          "clickable": true
        }
      ]
    }
  },
  "steps": [
    { "tool": "select_device", "args": { "platform": "android", "id": "mock-device" } },
    {
      "tool": "tap_and_wait_transition",
      "args": {
        "selector": { "id": "noop_btn" },
        "waitForAbsent": { "id": "header_label" },
        "timeoutMs": 20,
        "maxTimeoutMs": 40,
        "intervalMs": 5
      }
    }
  ]
}
