{
  "name": "tap-and-wait-transition-timeout-still-loading",
  "description": "tap_and_wait_transition times out with classification still_loading when a structural loading-role element (progressbar) is present on the one staged screen the whole time.",
  "driver": {
    "hierarchy": {
      "attributes": { "role": "container", "bounds": "0,0,430,932" },
      "children": [
        {
          "attributes": { "role": "button", "id": "retry_btn", "text": "Retry", "bounds": "100,400,330,460" },
          "children": [],
          "enabled": true,
          "clickable": true
        },
        {
          "attributes": { "role": "progressbar", "id": "spinner", "bounds": "165,500,265,540" },
          "children": []
        }
      ]
    }
  },
  "steps": [
    { "tool": "select_device", "args": { "platform": "android", "id": "mock-device" } },
    {
      "tool": "tap_and_wait_transition",
      "args": {
        "selector": { "id": "retry_btn" },
        "waitForAppear": { "id": "success_label" },
        "timeoutMs": 20,
        "maxTimeoutMs": 40,
        "intervalMs": 5
      }
    }
  ]
}
