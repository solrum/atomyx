    [
      { "id": "mock-1", "platform": "android", "name": "Mock Device", "kind": "emulator", "state": "online" }
    ]
  ],
  "driver": { "hierarchies": [{ "attributes": {}, "children": [] }] },
  "steps": [
    { "method": "selectDevice", "params": { "id": "mock-1" } },
    { "method": "listApps" },
    { "method": "launchApp", "params": { "bundleId": "com.example.app" } },
    { "method": "currentForeground" }
  ]
}
