    ],
    "appId": "dev.atomyx.demo",
    "description": "Logs in via the UI while the proxy captures the auth round-trip,\nthen validates the response with assertApi (status + body\nassertions) and pulls the access token out with extract for the\nnext request.\n",
    "env": {
      "email": "qa+capture@atomyx.test",
      "expectedUserId": "u_42",
      "password": "super-secret"
    },
    "format": "atomyx/v1",
    "name": "API capture + assertApi",
    "proxy": "required",
    "steps": [
      {
        "command": "launchApp"
      },
      {
        "command": "waitFor",
        "selector": {
          "label": "Sign in",
          "text": "Sign in"
        }
      },
      {
        "command": "type",
        "into": {
          "id": "email"
        },
        "text": "qa+capture@atomyx.test"
      },
      {
        "command": "type",
        "into": {
          "id": "password"
        },
        "text": "super-secret"
      },
      {
        "as": "loginRsp",
        "command": "capture",
        "pattern": "POST /api/v1/auth/login"
      },
      {
        "command": "tap",
        "selector": {
          "label": "Login",
          "text": "Login"
        }
      },
      {
        "body": {
          "$.access_token": "present",
          "$.user.email": "qa+capture@atomyx.test",
          "$.user.id": "u_42"
        },
        "command": "assertApi",
        "from": "loginRsp",
        "status": 200
      },
      {
        "command": "extract",
        "from": "loginRsp",
        "values": {
          "accessToken": "$.access_token",
          "sessionId": "$.session.id"
        }
      },
      {
        "as": "dashboardRsp",
        "command": "capture",
        "pattern": "GET /api/v1/me/dashboard"
      },
      {
        "command": "waitFor",
        "selector": {
          "label": "Dashboard",
          "text": "Dashboard"
        },
        "timeoutMs": 5000
      },
      {
        "body": {
          "$.notifications.unread": "present",
          "$.user.session_id": "${sessionId}"
        },
        "command": "assertApi",
        "from": "dashboardRsp",
        "status": 200
      },
      {
        "command": "screenshot",
        "label": "dashboard-loaded"
      }
    ],
    "tags": [
      "api",
      "capture",
      "assertApi"
    ]
  },
  "valid": true
}
