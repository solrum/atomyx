  "launch_app": {
    "description": "Launch an app on the connected device by its app identifier. The driver brings the app to the foreground; subsequent tool calls operate on its UI. Requires an active device, so call `select_device` first. Use `list_apps` to discover available identifiers.",
    "inputSchema": {
      "properties": {
        "appId": {
          "description": "Cross-platform app identifier (bundle id / package name). Use the string reported by `list_apps`.",
          "type": "string"
        }
      },
      "required": [
        "appId"
      ],
      "type": "object"
    }
  },
  "list_apps": {
    "description": "List apps installed on the current device. Returns app identifiers plus display labels. Call before launch_app when you need to confirm the exact identifier.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    }
  },
  "list_bugs": {
    "description": "List persisted bug reports from storage, sorted by timestamp descending (newest first). Returns summaries only. Use get_bug for the full record. Supports runId filter and offset/limit pagination. Response includes `totalMatching` + `nextOffset` for easy paging.",
    "inputSchema": {
      "properties": {
        "limit": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "runId": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "list_devices": {
    "description": "Enumerate connected devices across all supported platforms. Returns a flat list with { platform, id, name, state, kind } entries. Use this BEFORE starting the MCP server to pick the target device. Platforms whose toolchain isn't installed on the host are silently skipped.",
    "inputSchema": {
      "properties": {
        "platform": {
          "anyOf": [
            {
              "const": "ios"
            },
            {
              "const": "android"
            },
            {
              "const": "all"
            }
          ]
        }
      },
      "type": "object"
    }
  },
  "list_runs": {
    "description": "List persisted runs from storage, sorted by startedAt descending (most recent first). Returns summaries only. Each run carries `result` (passed, failed, or cancelled) and `outcome` (passed, failed, error, cancelled, deviceLost, or interrupted). A run that is still running has neither, and a run that never completed with no live writer is cancelled with outcome interrupted. `status` is kept for existing callers. Use get_run to fetch the full record including findings. Supports status filter and offset/limit pagination. The response includes `totalMatching`, the readable runs matching the filter, so callers can decide whether to request another page, and `skipped`, the number of stored runs that could not be read and are in neither count.",
    "inputSchema": {
      "properties": {
        "limit": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "status": {
          "anyOf": [
            {
              "const": "passed"
            },
            {
              "const": "failed"
            },
            {
              "const": "error"
            },
            {
              "const": "cancelled"
            },
            {
              "const": "running"
            }
          ]
        }
      },
      "type": "object"
    }
  },
  "press_key": {
    "description": "Press a system or navigation key (back, home, enter, etc.). Some keys may return ok=false when the platform has no equivalent primitive; the response hint explains the recommended on-screen fallback (e.g. tap a Cancel / Close button).",
    "inputSchema": {
      "properties": {
        "key": {
          "description": "Key name: back, home, enter, tab, escape, delete, etc.",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    }
  },
  "report_bug": {
    "description": "Record a bug finding in the currently-active run. Optionally captures a screenshot. Use this AFTER confirming the bug by observing the device state. Returns the bug id for reference.",
    "inputSchema": {
      "properties": {
        "captureScreenshot": {
          "type": "boolean"
        },
        "description": {
          "description": "Full description: expected vs actual, repro steps, any context the agent gathered (selectors tried, tool results, etc.).",
          "type": "string"
        },
        "title": {
          "description": "One-line bug title.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "type": "object"
    }
  },
  "run_script": {
    "description": "Execute a YAML test script deterministically against the current device. Steps run in order, and execution stops on the first failure. Returns structured results with a pass or fail outcome per step. When a failure happened because the device or agent went unreachable rather than an ordinary assertion or command failure, the failed step and the top level result both carry deviceLost true. A script whose proxy field is \"required\" needs a proxy argument on this call; without one the result carries ok false, zero steps, and a top level abort object naming why. Use this for regression runs or replaying recorded flows, not for exploratory testing.",
    "inputSchema": {
      "properties": {
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "proxy": {
          "description": "Network capture target for a script whose proxy field is \"required\", in \"type:path\" form, for example \"file:/tmp/capture.jsonl\". Omit when the script declares no proxy requirement.",
          "type": "string"
        },
        "script": {
          "description": "YAML test script content. Use the Atomyx YAML format with appId, name, env, and steps.",
          "type": "string"
        }
      },
      "required": [
        "script"
      ],
      "type": "object"
    }
  },
  "screenshot": {
    "description": "Use this only as a last resort, when get_ui_tree cannot answer your question (e.g. custom-rendered canvas, Flutter without semantics, visual layout validation, or when you suspect the UI tree is missing elements). Saves a compressed JPEG to .atomyx/screenshots/ and returns the file path. Read the file to view. Always try get_ui_tree or find_element FIRST because they are faster, cheaper, and give you actionable selectors directly.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    }
  },
  "select_device": {
    "description": "Bind the MCP session to a device so subsequent tools (launch_app, tap, get_ui_tree, etc.) operate on it. Enumerate candidates with list_devices first. Calling this again mid-session switches to a different device. The previous driver is disconnected cleanly.",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Device identifier as reported by list_devices.",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "const": "simulator"
            },
            {
              "const": "device"
            }
          ]
        },
        "platform": {
          "anyOf": [
            {
              "const": "ios"
            },
            {
              "const": "android"
            }
          ]
        },
        "port": {
          "type": "number"
        }
      },
      "required": [
        "platform",
        "id"
      ],
      "type": "object"
    }
  },
  "start_run": {
    "description": "Start a new test run. Call this BEFORE driving the device so bug reports and case studies can be attached to a named run. Any previously-active run is implicitly force-closed as 'error' and its record is persisted to runs/\u003cid\u003e so the lost run's trail isn't dropped. The returned `erroredPredecessor` field carries the old run id when this happens.",
    "inputSchema": {
      "properties": {
        "name": {
          "description": "Human description of the run.",
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  "swipe": {
    "description": "Swipe the screen. Pass {direction: 'up'|'down'|'left'|'right'} for a centered directional scroll (default 60% of screen), or {fromX, fromY, toX, toY} for a precise two-point swipe. durationMs default 200.",
