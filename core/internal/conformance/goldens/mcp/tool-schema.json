  "update_run_summary": {
    "description": "Set or replace the summary field on a persisted run. Useful when the summary wasn't known at finish_run time, or to append context discovered by a later investigation. Only the summary field is mutated, while all other fields (status, findings, durationMs, …) are preserved. Applies to runs started by start_run or run_script, whether open or finished. A run with no summary field, such as one written by the atomyx CLI, returns error RUN_READ_ONLY naming the run. A run another process is still writing returns the same error until it finishes. Returns ok:false when the id is not found.",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Run id to update.",
          "type": "string"
        },
        "summary": {
          "description": "New summary text. Pass an empty string to clear.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "summary"
      ],
      "type": "object"
    }
  },
