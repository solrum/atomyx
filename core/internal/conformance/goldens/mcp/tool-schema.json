{
  "add_case_study": {
    "description": "Append a learned lesson to the case-studies playbook. Use AFTER recovering from a non-obvious error (obscurement dismissal, scroll-search edge case, flaky transition) so future sessions can read it. Records are markdown under case-studies/YYYY-MM/\u003cslug\u003e.",
    "inputSchema": {
      "properties": {
        "example": {
          "type": "string"
        },
        "solution": {
          "description": "What worked to recover.",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "trigger": {
          "description": "What situation caused the pain.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "trigger",
        "solution"
      ],
      "type": "object"
    }
  },
  "delete_bug": {
    "description": "Delete a persisted bug report. Removes BOTH `bugs/\u003cid\u003e` and its sibling `bugs/\u003cid\u003e/screenshot` key when present, so no orphan screenshot payloads are left behind. Returns ok:false when the id is not found (before any delete happens, so partial-delete states are impossible).",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Bug id to delete.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  "delete_run": {
    "description": "Delete a persisted run. Removes every stored form of the run. Associated bug records (`bugs/\u003crunId\u003e-bug-\u003cn\u003e`) are NOT cascade-deleted, and they remain accessible via get_bug with their runId field pointing at the now-missing run. Use list_bugs with the runId filter then delete_bug to clean those up individually if desired. Returns ok:false when the id is not found.",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Run id to delete.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  "disconnect_device": {
    "description": "Disconnect the currently-active device and leave the session idle. Subsequent tool calls that need a device will fail until select_device is called again. Returns ok:true even when no device was bound (idempotent).",
    "inputSchema": {
      "properties": {},
      "type": "object"
    }
  },
