{
  "$id": "https://schemas.atomyx.dev/run.schema.json",
  "$ref": "#/definitions/RunMeta",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Device": {
      "additionalProperties": true,
      "properties": {
        "hardwareId": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "required": [
        "platform"
      ],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": true,
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "screenshotPath": {
          "type": "string"
        },
        "timestamp": {
          "description": "Epoch milliseconds.",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "timestamp"
      ],
      "type": "object"
    },
    "Host": {
      "additionalProperties": true,
      "properties": {
        "agentVersion": {
          "type": "string"
        },
        "atomyxVersion": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Intervention": {
      "additionalProperties": true,
      "properties": {
        "artifacts": {
          "description": "A humanAction only: run-relative files the step produced.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "atMs": {
          "description": "Epoch milliseconds when it happened.",
          "minimum": 0,
          "type": "integer"
        },
        "client": {
          "description": "Name of the process that acted.",
          "type": "string"
        },
        "command": {
          "description": "A humanAction only: the command name of the step.",
          "type": "string"
        },
        "durationMs": {
          "description": "A humanAction only: how long the step took.",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "description": "What happened, such as viewerAttached, viewerDetached, controlBorrowed or humanAction.",
          "type": "string"
        },
        "message": {
          "description": "A humanAction only: why the step failed, with secret values masked.",
          "type": "string"
        },
        "outcome": {
          "description": "A humanAction only: passed or failed.",
          "type": "string"
        },
        "step": {
          "description": "A humanAction only: the step as the person wrote it. The text of a type step is always masked.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "atMs",
        "client"
      ],
      "type": "object"
    },
    "InterventionEntry": {
      "oneOf": [
        {
          "$ref": "#/definitions/Intervention"
        },
        {
          "$ref": "#/definitions/InterventionsTruncated"
        }
      ]
    },
    "InterventionsTruncated": {
      "additionalProperties": true,
      "properties": {
        "limitBytes": {
          "minimum": 1,
          "type": "integer"
        },
        "truncated": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "truncated",
        "limitBytes"
      ],
      "type": "object"
    },
    "MCPInfo": {
      "additionalProperties": true,
      "properties": {
        "actionCount": {
          "minimum": 0,
          "type": "integer"
        },
        "durationMs": {
          "minimum": 0,
          "type": "integer"
        },
        "findings": {
          "items": {
            "$ref": "#/definitions/Finding"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "source",
        "actionCount",
        "durationMs"
      ],
      "type": "object"
    },
    "Recording": {
      "additionalProperties": true,
      "properties": {
        "code": {
          "description": "Stable error code. Present when state is unsupported or error.",
          "type": "string"
        },
        "files": {
          "description": "Video file names relative to the artifacts directory, oldest first. Present when state is kept.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "state": {
          "description": "How the screen recording ended.",
          "enum": [
            "kept",
            "unsupported",
            "error"
          ],
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "RunMeta": {
      "additionalProperties": true,
      "properties": {
        "completedAt": {
          "description": "Epoch milliseconds when the run finished. Absent for a run that never finished.",
          "minimum": 0,
          "type": "integer"
        },
        "device": {
          "$ref": "#/definitions/Device"
        },
        "deviceId": {
          "type": "string"
        },
        "failedAtStep": {
          "minimum": 0,
          "type": "integer"
        },
        "flakyEntries": {
          "description": "How many suite entries failed and then passed on a retry. Absent when none did.",
          "minimum": 1,
          "type": "integer"
        },
        "host": {
          "$ref": "#/definitions/Host"
        },
        "importedFrom": {
          "description": "Id of the record of another store this folder was imported from. Absent for a run written natively.",
          "type": "string"
        },
        "interventionsDropped": {
          "description": "How many intervention lines did not fit in interventions.jsonl. Absent when none were dropped.",
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "description": "What started the run.",
          "enum": [
            "script",
            "suite",
            "mcp"
          ],
          "type": "string"
        },
        "mcp": {
          "$ref": "#/definitions/MCPInfo"
        },
        "outcome": {
          "description": "Precise reason the run ended.",
          "enum": [
            "passed",
            "failed",
            "error",
            "cancelled",
            "deviceLost",
            "interrupted"
          ],
          "type": "string"
        },
        "quarantinedFailures": {
          "description": "How many quarantined suite entries failed. Absent when none did.",
          "minimum": 1,
          "type": "integer"
        },
        "recording": {
          "$ref": "#/definitions/Recording"
        },
        "result": {
          "description": "Coarse verdict.",
          "enum": [
            "passed",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        "runId": {
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "scriptName": {
          "type": "string"
        },
        "scriptPath": {
          "type": "string"
        },
        "startedAt": {
          "description": "Epoch milliseconds when the run started.",
          "minimum": 0,
          "type": "integer"
        },
        "totalSteps": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "kind",
        "startedAt"
      ],
      "type": "object"
    },
    "StepLine": {
      "additionalProperties": true,
      "properties": {
        "artifacts": {
          "description": "Run-relative file names the step produced.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attempt": {
          "description": "Attempt number of a retried suite entry. Absent for the first attempt.",
          "minimum": 2,
          "type": "integer"
        },
        "command": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "durationMs": {
          "minimum": 0,
          "type": "integer"
        },
        "ok": {
          "type": "boolean"
        },
        "phase": {
          "description": "Which side of the step the line reports.",
          "enum": [
            "started",
            "completed"
          ],
          "type": "string"
        },
        "runId": {
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "seq": {
          "description": "Position of the line in its run, from 1.",
          "minimum": 1,
          "type": "integer"
        },
        "stepIndex": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "seq",
        "stepIndex",
        "command",
        "phase",
        "ok",
        "durationMs",
        "detail",
        "artifacts"
      ],
      "type": "object"
    }
  }
}
