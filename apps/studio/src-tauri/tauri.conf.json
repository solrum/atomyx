{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Atomyx Studio",
  "version": "0.1.0",
  "identifier": "dev.atomyx.studio",
  "build": {
    "beforeDevCommand": "make -C ../.. build-core && mkdir -p src-tauri/resources && cp ../../core/bin/atomyx-runtime src-tauri/resources/atomyx-runtime && cp ../../core/bin/atomyx-runtime src-tauri/target/debug/atomyx-runtime 2>/dev/null; npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && make -C ../.. build-core && mkdir -p src-tauri/resources && cp ../../core/bin/atomyx-runtime src-tauri/resources/atomyx-runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atomyx Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "resources": {
      "resources/atomyx-runtime": "atomyx-runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "DeveloperTool",
    "copyright": "© 2026 Solrum",
    "shortDescription": "Atomyx Studio",
    "longDescription": "Desktop IDE for authoring, validating, and running Atomyx YAML test scripts on real mobile devices.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "exceptionDomain": null,
      "signingIdentity": null,
      "providerShortName": null
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": true,
      "endpoints": [
        "https://github.com/solrum/atomyx/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
